/* Rainbow Road palette: jewel-bright accents over deep space purple. */
SettingsWindow, OffroadHome, Sidebar, FrogPilotSettingsWindow {
  background-color: #090619;
  color: #f7f4ff;
}
QPushButton {
  color: #f7f4ff;
  border: 2px solid #57427b;
  border-bottom: 4px solid qlineargradient(x1:0, y1:0, x2:1, y2:0,
    stop:0 #ff3653, stop:0.14 #ff8a1f, stop:0.28 #ffe23f,
    stop:0.43 #43e85b, stop:0.57 #21dcff, stop:0.71 #4666ff,
    stop:0.86 #ad46ff, stop:1 #ff43c7);
}
QPushButton:pressed { border-color: #21dcff; }
QPushButton:disabled { color: #a69bbd; border-color: #57427b; }
